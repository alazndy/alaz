# Required everywhere. At least 32 characters; make one with: openssl rand -hex 32
IP_HASH_SECRET=
# The only address that may change status, delete reports, and invite people.
ADMIN_EMAIL=

# Sign-in (Clerk).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Real server: Postgres (Neon) and a private Vercel Blob store. Vercel sets these when the stores are connected.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Development only, instead of the two stores above. Refused in production and on Vercel.
FEEDBACK_LOCAL_DIR=
