[Unit]
Description=Alaz relay (join by code)
After=network-online.target
# Without a certificate the relay cannot start; skip instead of restart-looping.
ConditionPathExists=/etc/alaz-relay/tls/privkey.pem
Wants=network-online.target

[Service]
# A named user (not DynamicUser): the certificate files in /etc/alaz-relay/tls
# must be readable by a fixed group that renew-cert.sh can chown to.
User=alaz-relay
Group=alaz-relay
ExecStart=/usr/local/bin/alaz-relay \
    --listen 0.0.0.0:443 \
    --cert /etc/alaz-relay/tls/fullchain.pem \
    --key /etc/alaz-relay/tls/privkey.pem \
    --stats-addr 127.0.0.1:9100
Restart=on-failure
RestartSec=2s

# Port 443 is below 1024; this is the only privilege the process gets.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Default Limits: max_tunnels 4000 x 2 sockets + max_rooms 1000 control sockets
# = 9000 steady state. 65536 leaves room for handshakes in flight and floods.
LimitNOFILE=65536
# One thread per connection; 9000 sockets can mean thousands of threads.
TasksMax=20000

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
