[Unit]
Description=Alaz relay (join by code)
After=network-online.target
# Without a certificate the relay cannot start; skip instead of restart-looping.
ConditionPathExists=/etc/alaz-relay/tls/privkey.pem
Wants=network-online.target

[Service]
# A named user (not DynamicUser): the certificate files in /etc/alaz-relay/tls
# must be readable by a fixed group that renew-cert.sh can chown to.
User=alaz-relay
Group=alaz-relay
ExecStart=/usr/local/bin/alaz-relay \
    --listen 0.0.0.0:443 \
    --cert /etc/alaz-relay/tls/fullchain.pem \
    --key /etc/alaz-relay/tls/privkey.pem \
    --stats-addr 127.0.0.1:9100
Restart=on-failure
RestartSec=2s

# Port 443 is below 1024; this is the only privilege the process gets.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Sizes follow Limits::default() (see RUNBOOK "Kaynak hesabı"):
#   max_total_conns 3000 sockets, one thread each, two fds each (stream + clone) = 6000 fds
#   plus listeners and the one fd being admitted. 16384 leaves a wide margin.
LimitNOFILE=16384
# 3000 connection threads + 4 service threads (main, stats, signals, cert watch) = 3004.
TasksMax=3200
# 3000 threads x about 110 KiB (small stack, TLS state, copy buffer) = about 330 MiB.
# MemoryHigh makes the kernel reclaim first; MemoryMax is the hard stop for the unit only.
MemoryHigh=400M
MemoryMax=512M

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictSUIDSGID=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
UMask=0077

[Install]
WantedBy=multi-user.target
